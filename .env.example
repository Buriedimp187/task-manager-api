# Copy to .env and fill in real values. Never commit .env.
# If the password contains a $ character, wrap it in single quotes (POSTGRES_PASSWORD='...').
# Otherwise Docker Compose treats $ as a variable and silently cuts the password short.
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=<database-name>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Signs access tokens. Must be at least 32 characters; the placeholder below is deliberately too short,
# so the app refuses to start until you replace it. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone who knows it can forge a login for any user. Never commit it, and change it if it leaks.
SECRET_KEY=<replace-with-random-secret>

# Optional database limits. Each line shows the default; uncomment and edit only the ones you want to change.
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_LOCK_TIMEOUT_MS=3000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=1800
# REQUEST_THREADS=20

# Abuse protection for /auth (defaults shown). Counters are kept in this process's memory.
# REGISTRATION_ENABLED=true        # set to false in production to close registration; login keeps working
# LOGIN_IP_LIMIT=10
# LOGIN_IP_WINDOW_SECONDS=60
# LOGIN_USER_LIMIT=5
# LOGIN_USER_WINDOW_SECONDS=60
# REGISTER_IP_LIMIT=5
# REGISTER_IP_WINDOW_SECONDS=3600
# Reverse proxies whose X-Forwarded-For header may be believed, e.g. 10.0.0.5,172.16.0.0/12. Empty = never.
# Run uvicorn with --no-proxy-headers so only this setting decides.
# TRUSTED_PROXIES=

# Most tasks one account may hold (default 1000). Creating more is refused with 409.
# MAX_TASKS_PER_USER=1000

# Docker (docker-compose.yml). The container reads this file too; these lines are the production defaults.
# API_PORT=8000                    # host port for the API, bound to 127.0.0.1 only
# DOCS_ENABLED=false               # /docs, /redoc and /openapi.json. The development override turns them on.
# REGISTRATION_ENABLED=false       # in the container this defaults to false; set true on purpose to open it
