# Copy to .env and fill in real values. Never commit .env.
# If the password contains a $ character, wrap it in single quotes (POSTGRES_PASSWORD='...').
# Otherwise Docker Compose treats $ as a variable and silently cuts the password short.
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_DB=<database-name>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
